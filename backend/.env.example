# SceneSpeak Environment Variables Template
# Copy this file to `backend/.env` and update the values.

# --- Model Provider Configuration ---
# Choose your provider: "gemini" or "openai"
VLM_PROVIDER=gemini

# API Key for your chosen provider
VLM_API_KEY=your_api_key_here

# Specific model name (e.g. "gemini-2.0-flash" or "gpt-4o-mini")
VLM_MODEL=gemini-2.0-flash

# Optional: custom base URL for OpenAI-compatible proxies
# VLM_BASE_URL=https://api.openai.com/v1

# --- Security & Limits ---
# Maximum payload size in bytes (2 MB = 2,000,000 bytes)
MAX_IMAGE_BYTES=2000000

# Rate limit: maximum requests per minute per IP
RATE_LIMIT_PER_MIN=30

# --- Database ---
# SQLite database path
DATABASE_URL=sqlite:///./scenespeak.db

# --- Server Settings ---
HOST=0.0.0.0
PORT=8000
